# Copy to .env.local (Next.js) / export in your shell (CLI). Never commit real values.

# --- Database -------------------------------------------------------------
# Production: hosted PostgreSQL (Neon, Supabase, RDS...). Local dev: embedded PGlite (default).
DATABASE_URL=pglite:./.data/pglite
# Apply migrations automatically when the web app first connects to Postgres (PGlite always migrates).
AUTO_MIGRATE=false

# --- Data mode ------------------------------------------------------------
# live = real providers; demo = clearly labelled synthetic prices for offline development.
DATA_MODE=live

# --- SEC EDGAR (free, no key) ---------------------------------------------
# Required by SEC fair-access policy: "<App or company name> <contact email>"
SEC_USER_AGENT=
SEC_REQUESTS_PER_MINUTE=300

# --- Market data: Polygon.io / Massive -------------------------------------
POLYGON_API_KEY=
# Must match your plan: end_of_day (free) | delayed_15m | real_time
POLYGON_DATA_NATURE=end_of_day
POLYGON_REQUESTS_PER_MINUTE=5
# POLYGON_BASE_URL=https://api.polygon.io

# --- Macro data: FRED -----------------------------------------------------
FRED_API_KEY=
FRED_REQUESTS_PER_MINUTE=60

# --- News + earnings calendar: Finnhub ------------------------------------
FINNHUB_API_KEY=
FINNHUB_REQUESTS_PER_MINUTE=50

# --- Universe & calendar --------------------------------------------------
# Comma-separated tickers to track (defaults to a 20-company starter list).
TRACKED_TICKERS=
# Unscheduled exchange closures, comma-separated YYYY-MM-DD.
MARKET_EXTRA_CLOSURES=
CANDLE_HISTORY_YEARS=5
NEWS_RETENTION_DAYS=120
JOB_RUN_RETENTION_DAYS=180

# --- Admin & scheduling ---------------------------------------------------
# At least 16 random characters each. ADMIN_TOKEN signs into /status and authorizes manual refresh.
ADMIN_TOKEN=
SESSION_SECRET=
# Optional: bearer secret for /api/cron/scheduled (Vercel Cron or another external scheduler).
CRON_SECRET=
# Optional: make the admin "Refresh" buttons dispatch the GitHub Actions workflow instead of running inline.
GITHUB_REPOSITORY=
GITHUB_DISPATCH_TOKEN=
GITHUB_DISPATCH_REF=main

# --- AI explanations (optional) --------------------------------------------
# Plain-English market brief, news grouping and filing summaries. Grounded in stored data only.
# Without a key the site works normally and simply shows no AI explanations.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5
# Hard daily cap on tokens (input + output). ~400k tokens ≈ $0.40–2/day on Haiku 4.5 at most.
AI_DAILY_TOKEN_BUDGET=400000
AI_FILINGS_PER_NIGHT=5
AI_SUMMARIES_PER_HOUR=10
